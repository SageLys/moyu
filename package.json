  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "puppeteer": "^25.2.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.9"
  }
}
